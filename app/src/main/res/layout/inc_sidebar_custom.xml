<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:background="@color/sidebar_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/sidebarHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="60dp"
            android:src="@drawable/logo_sgdh"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"

            android:background="@drawable/bg_sidebar_logo"
            android:padding="8dp"/>
    </LinearLayout>

    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sidebar_divider"
        app:layout_constraintTop_toBottomOf="@id/sidebarHeader"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintBottom_toTopOf="@id/dividerBottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/menu_inicio"
                style="@style/SidebarItem"
                android:text="Inicio"
                app:drawableStartCompat="@android:drawable/ic_menu_rotate"/>

            <TextView
                android:id="@+id/menu_solicitudes"
                style="@style/SidebarItem"
                android:text="Solicitudes"
                app:drawableStartCompat="@android:drawable/ic_menu_agenda"/>

            <TextView
                android:id="@+id/menu_bitacora"
                style="@style/SidebarItem"
                android:text="Bitácora"
                app:drawableStartCompat="@android:drawable/ic_menu_edit"/>
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/dividerBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/sidebar_divider"
        app:layout_constraintBottom_toTopOf="@id/sidebarFooter"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sidebarFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@color/sidebar_bg"
        app:layout_constraintBottom_toBottomOf="parent"> <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnLogout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:textColor="@color/sidebar_text"
            android:textStyle="bold"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"/> <TextView
        android:id="@+id/tvUserEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="..."
        android:textColor="@color/sidebar_text_muted"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp"/> </LinearLayout>

        <ImageView
            android:id="@+id/btnLogout"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_lock_power_off"
            app:tint="@color/sidebar_text_muted"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>